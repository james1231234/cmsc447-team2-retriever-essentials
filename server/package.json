{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Retriever Essentials Backend",
  "type": "module",

  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },

  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },

  "packageManager": "pnpm@12.15.0",

  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
